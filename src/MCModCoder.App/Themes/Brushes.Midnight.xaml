<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      午夜蓝
      深板岩夜色 + 海晶灯青绿强调。比深空黑更冷、更沉浸，适合长时间夜间开发；
      青绿强调色是这套主题的记忆点。
    -->

    <!-- 全局画刷 -->
    <SolidColorBrush x:Key="BgBrush"        Color="#10141C"/>
    <SolidColorBrush x:Key="PanelBrush"     Color="#161B26"/>
    <SolidColorBrush x:Key="Panel2Brush"    Color="#1C2231"/>
    <SolidColorBrush x:Key="BorderBrush"    Color="#2A3244"/>
    <SolidColorBrush x:Key="TextBrush"      Color="#DFE6F2"/>
    <SolidColorBrush x:Key="TextDimBrush"   Color="#8B96AC"/>
    <SolidColorBrush x:Key="AccentBrush"    Color="#45D6B8"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#1E4A44"/>
    <SolidColorBrush x:Key="GreenBrush"     Color="#5BD68F"/>
    <SolidColorBrush x:Key="RedBrush"       Color="#F27B7B"/>
    <SolidColorBrush x:Key="YellowBrush"    Color="#E8C468"/>
    <SolidColorBrush x:Key="HoverBrush"     Color="#222938"/>

    <SolidColorBrush x:Key="SlotBrush"      Color="#8B8B8B"/>
    <SolidColorBrush x:Key="SlotDarkBrush"  Color="#333B4A"/>
    <SolidColorBrush x:Key="SlotLightBrush" Color="#FFFFFF"/>

    <!-- 补充画刷 -->
    <SolidColorBrush x:Key="InputBgBrush"   Color="#0C1017"/>
    <SolidColorBrush x:Key="AccentHoverBrush"  Color="#6FE8D0"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2FB49A"/>
    <SolidColorBrush x:Key="BtnPressedBrush"   Color="#0D1119"/>
    <SolidColorBrush x:Key="ThumbBrush"     Color="#313B50"/>
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="#3E4A63"/>
    <SolidColorBrush x:Key="SubtleBrush"    Color="#46536B"/>
    <SolidColorBrush x:Key="AccentCheckBgBrush" Color="#16352F"/>

    <!-- 画布 / 视口深底 -->
    <SolidColorBrush x:Key="DeepBgBrush"    Color="#0B0F16"/>
    <SolidColorBrush x:Key="VoidBrush"      Color="#080B10"/>
    <SolidColorBrush x:Key="CodeBgBrush"    Color="#0D1119"/>
    <SolidColorBrush x:Key="LogBgBrush"     Color="#0A0D13"/>
    <SolidColorBrush x:Key="LogTextBrush"   Color="#7FE3D0"/>
    <SolidColorBrush x:Key="OverlayBrush"   Color="#E610141C"/>
    <SolidColorBrush x:Key="PopupBgBrush"   Color="#181E2B"/>
    <SolidColorBrush x:Key="PanelGlassBrush"  Color="#CC161B26"/>
    <SolidColorBrush x:Key="PanelStrongBrush" Color="#E6161B26"/>

    <!-- 派生状态画刷（各主题单独校准） -->
    <SolidColorBrush x:Key="AccentBorderBrush"  Color="#2E6B60"/>
    <SolidColorBrush x:Key="GridLineBrush"      Color="#232B3B"/>
    <SolidColorBrush x:Key="RowAltBrush"        Color="#141926"/>
    <SolidColorBrush x:Key="DangerHoverBrush"   Color="#F69393"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#D55555"/>
    <SolidColorBrush x:Key="SuccessHoverBrush"  Color="#79DEA2"/>
    <SolidColorBrush x:Key="SuccessPressedBrush" Color="#43B57E"/>
</ResourceDictionary>
