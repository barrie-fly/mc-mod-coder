<Window x:Class="MCModCoder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MC模组代码工作台 — Minecraft 模组与整合包集成开发环境"
        Width="1440" Height="880" MinWidth="1120" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="6" ClipToBounds="True">
                        <Image Source="Assets/logo-mark.png" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MC模组代码工作台" FontSize="16" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="v1.0" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- 全局快速搜索（Ctrl+K） -->
                    <Grid x:Name="SearchHost" Width="280" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBox x:Name="GlobalSearchBox" TextChanged="GlobalSearch_TextChanged"
                                 KeyDown="GlobalSearch_KeyDown" Padding="26,4,52,4"/>
                        <TextBlock Text="🔍" FontSize="12" IsHitTestVisible="False" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="快速搜索模块 / 文件 / 代码…" IsHitTestVisible="False"
                                   Margin="27,0,8,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextDimBrush}"/>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                Background="{DynamicResource Panel2Brush}" CornerRadius="3" Padding="5,1"
                                IsHitTestVisible="False">
                            <TextBlock Text="Ctrl+K" FontSize="10" Foreground="{DynamicResource TextDimBrush}"/>
                        </Border>
                        <Popup x:Name="SearchPopup" AllowsTransparency="True" StaysOpen="False"
                               Placement="Bottom" PlacementTarget="{Binding ElementName=SearchHost}">
                            <Border Background="{DynamicResource PopupBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Width="440" MaxHeight="430" Margin="0,4,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" Color="#000000"/>
                                </Border.Effect>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="↑↓ 选择 · Enter 打开 · Esc 关闭" FontSize="10.5"
                                               Foreground="{DynamicResource TextDimBrush}" Margin="10,6,10,6"/>
                                    <ListBox x:Name="SearchResultsList" BorderThickness="0" Background="Transparent"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             PreviewMouseLeftButtonUp="SearchResults_Click">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,6">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Background="{DynamicResource AccentDimBrush}" CornerRadius="3"
                                                                    Padding="5,1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Kind}" FontSize="10"
                                                                           Foreground="{DynamicResource TextBrush}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                       Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="340"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource DimText}"
                                                                   FontSize="11" Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <TextBlock x:Name="ProjectInfoText" Text="未打开项目" Foreground="{DynamicResource TextDimBrush}"
                               VerticalAlignment="Center" Margin="0,0,14,0" MaxWidth="260"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <!-- 外观设置：主题色板 + 界面排版（弹层选择） -->
                    <Button x:Name="BtnAppearance" Content="🎨 外观" Click="BtnAppearance_Click" Margin="0,0,10,0"/>
                    <Button x:Name="BtnNewProject" Content="新建项目" Style="{StaticResource AccentButton}" Click="BtnNewProject_Click" Margin="0,0,6,0"/>
                    <Button x:Name="BtnOpenProject" Content="打开项目" Click="BtnOpenProject_Click"/>
                    <Button x:Name="BtnCloseProject" Content="关闭" Click="BtnCloseProject_Click" Margin="6,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 外观设置弹层：主题色卡 + 排版示意卡 -->
        <Popup x:Name="AppearancePopup" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
               Placement="Bottom" PlacementTarget="{Binding ElementName=BtnAppearance}">
            <Border Background="{DynamicResource PopupBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Width="356" Margin="0,6,0,0" Padding="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="外观主题" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDimBrush}" Margin="2,0,0,8"/>
                    <UniformGrid Columns="3" Rows="2">
                        <!-- 每张色卡：目标主题的 底色 / 面板 / 强调色 三色预览 -->
                        <RadioButton x:Name="ThemeDark" Style="{StaticResource OptionCard}" GroupName="themeCard"
                                     Tag="dark" Margin="0,0,8,8" ToolTip="深空黑 — 石墨色阶 + 电光蓝，默认主题">
                            <StackPanel>
                                <Border Height="34" CornerRadius="6" Background="#17181B" BorderBrush="#33363D"
                                        BorderThickness="1" ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Rectangle Width="13" Height="13" RadiusX="3" RadiusY="3" Fill="#1F2126" Stroke="#33363D" Margin="2,0"/>
                                        <Rectangle Width="13" Height="13" RadiusX="3" RadiusY="3" Fill="#4C8DFF" Margin="2,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="深空黑" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ThemeLight" Style="{StaticResource OptionCard}" GroupName="themeCard"
                                     Tag="light" Margin="0,0,8,8" ToolTip="极昼白 — 暖纸白 + 琥珀橙，浅色工坊">
                            <StackPanel>
                                <Border Height="34" CornerRadius="6" Background="#F4F2ED" BorderBrush="#D8D4CB"
                                        BorderThickness="1" ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Rectangle Width="13" Height="13" RadiusX="3" RadiusY="3" Fill="#FBFAF7" Stroke="#D8D4CB" Margin="2,0"/>
                                        <Rectangle Width="13" Height="13" RadiusX="3" RadiusY="3" Fill="#B85C1F" Margin="2,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="极昼白" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ThemeMidnight" Style="{StaticResource OptionCard}" GroupName="themeCard"
                                     Tag="midnight" Margin="0,0,8,8" ToolTip="午夜蓝 — 深板岩夜色 + 海晶灯青绿">
                            <StackPanel>
                                <Border Height="34" CornerRadius="6" Background="#10141C" BorderBrush="#2A3244"
                                        BorderThickness="1" ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Rectangle Width="13" Height="13" RadiusX="3" RadiusY="3" Fill="#161B26" Stroke="#2A3244" Margin="2,0"/>
                                        <Rectangle Width="13" Height="13" RadiusX="3" RadiusY="3" Fill="#45D6B8" Margin="2,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="午夜蓝" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ThemeGrass" Style="{StaticResource OptionCard}" GroupName="themeCard"
                                     Tag="grass" Margin="0,0,8,0" ToolTip="草原绿 — 主世界暗绿底 + 草方块绿">
                            <StackPanel>
                                <Border Height="34" CornerRadius="6" Background="#121710" BorderBrush="#2C3A26"
                                        BorderThickness="1" ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Rectangle Width="13" Height="13" RadiusX="3" RadiusY="3" Fill="#182015" Stroke="#2C3A26" Margin="2,0"/>
                                        <Rectangle Width="13" Height="13" RadiusX="3" RadiusY="3" Fill="#7CC64A" Margin="2,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="草原绿" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ThemeLava" Style="{StaticResource OptionCard}" GroupName="themeCard"
                                     Tag="lava" ToolTip="熔岩橙 — 下界暖黑岩底 + 熔岩橙">
                            <StackPanel>
                                <Border Height="34" CornerRadius="6" Background="#191210" BorderBrush="#3D2E26"
                                        BorderThickness="1" ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Rectangle Width="13" Height="13" RadiusX="3" RadiusY="3" Fill="#221A16" Stroke="#3D2E26" Margin="2,0"/>
                                        <Rectangle Width="13" Height="13" RadiusX="3" RadiusY="3" Fill="#FF7A2F" Margin="2,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="熔岩橙" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <TextBlock Text="界面排版" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDimBrush}" Margin="2,14,0,8"/>
                    <UniformGrid Columns="2" Rows="2">
                        <!-- 每张排版卡：导航区（强调色条）+ 内容区（面板块）示意图 -->
                        <RadioButton x:Name="LayoutLeft" Style="{StaticResource OptionCard}" GroupName="layoutCard"
                                     Tag="left" Margin="0,0,8,8" ToolTip="左侧栏 — 经典布局，导航在左">
                            <StackPanel>
                                <Grid Width="88" Height="42" Margin="0,2">
                                    <Border Background="{DynamicResource Panel2Brush}" CornerRadius="6"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                    <Border Width="16" Height="34" HorizontalAlignment="Left" Margin="4,0"
                                            Background="{DynamicResource AccentBrush}" CornerRadius="3" Opacity="0.85"/>
                                    <Border Width="44" Height="26" HorizontalAlignment="Right" Margin="0,0,6,0"
                                            Background="{DynamicResource PanelBrush}" CornerRadius="3"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                </Grid>
                                <TextBlock Text="左侧栏" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="LayoutRight" Style="{StaticResource OptionCard}" GroupName="layoutCard"
                                     Tag="right" Margin="0,0,8,8" ToolTip="右侧栏 — 导航靠右，内容居左">
                            <StackPanel>
                                <Grid Width="88" Height="42" Margin="0,2">
                                    <Border Background="{DynamicResource Panel2Brush}" CornerRadius="6"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                    <Border Width="16" Height="34" HorizontalAlignment="Right" Margin="0,0,4,0"
                                            Background="{DynamicResource AccentBrush}" CornerRadius="3" Opacity="0.85"/>
                                    <Border Width="44" Height="26" HorizontalAlignment="Left" Margin="6,0,0,0"
                                            Background="{DynamicResource PanelBrush}" CornerRadius="3"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                </Grid>
                                <TextBlock Text="右侧栏" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="LayoutTop" Style="{StaticResource OptionCard}" GroupName="layoutCard"
                                     Tag="top" Margin="0,0,8,0" ToolTip="顶部导航 — 横向菜单，内容区最大化">
                            <StackPanel>
                                <Grid Width="88" Height="42" Margin="0,2">
                                    <Border Background="{DynamicResource Panel2Brush}" CornerRadius="6"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                    <Border Height="10" VerticalAlignment="Top" Margin="4,4,4,0"
                                            Background="{DynamicResource AccentBrush}" CornerRadius="3" Opacity="0.85"/>
                                    <Border Width="60" Height="20" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                            Margin="0,0,0,4" Background="{DynamicResource PanelBrush}" CornerRadius="3"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                </Grid>
                                <TextBlock Text="顶部导航" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="LayoutMini" Style="{StaticResource OptionCard}" GroupName="layoutCard"
                                     Tag="mini" ToolTip="精简侧栏 — 仅图标导航，节省横向空间">
                            <StackPanel>
                                <Grid Width="88" Height="42" Margin="0,2">
                                    <Border Background="{DynamicResource Panel2Brush}" CornerRadius="6"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                    <Border Width="8" Height="34" HorizontalAlignment="Left" Margin="4,0"
                                            Background="{DynamicResource AccentBrush}" CornerRadius="2" Opacity="0.85"/>
                                    <Border Width="52" Height="26" HorizontalAlignment="Right" Margin="0,0,6,0"
                                            Background="{DynamicResource PanelBrush}" CornerRadius="3"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                </Grid>
                                <TextBlock Text="精简侧栏" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 主体：可重排（左侧栏 / 右侧栏 / 顶部导航 / 精简侧栏，由 ThemeManager 驱动） -->
        <DockPanel x:Name="BodyRoot" Grid.Row="1" LastChildFill="True">
            <!-- 顶部导航条：仅「顶部导航」排版可见，NavPanel 运行时搬入 TopNavHost -->
            <Border x:Name="TopNavBorder" DockPanel.Dock="Top"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="10,4" Visibility="Collapsed">
                <ScrollViewer x:Name="TopNavHost" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"/>
            </Border>

            <!-- 侧边导航栏：左侧栏 / 右侧栏 / 精简侧栏排版可见 -->
            <Border x:Name="SidebarBorder" DockPanel.Dock="Left" Width="216"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock x:Name="SidebarHeader" DockPanel.Dock="Top" Text="功能模块"
                               Style="{StaticResource NavSection}" Margin="16,12,0,6"/>
                    <ScrollViewer x:Name="NavScrollHost" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NavPanel" Margin="8,0,8,10">
                            <RadioButton x:Name="NavOverview"  Content="🏠  项目总览"   Style="{StaticResource NavButton}" GroupName="nav" IsChecked="True" Margin="6,2,6,10"/>
                            <TextBlock Text="设计" Style="{StaticResource NavSection}" Tag="sec"/>
                            <Rectangle Tag="sep" Width="1" Height="22" Margin="10,8" VerticalAlignment="Center"
                                       Fill="{DynamicResource BorderBrush}" Visibility="Collapsed"/>
                            <RadioButton x:Name="NavPixel"     Content="🎨  物品图像设计" Style="{StaticResource NavButton}" GroupName="nav"/>
                            <RadioButton x:Name="NavRecipe"    Content="⚗️  配方设置"   Style="{StaticResource NavButton}" GroupName="nav"/>
                            <RadioButton x:Name="NavStructure" Content="🧱  多方块结构设计" Style="{StaticResource NavButton}" GroupName="nav"/>
                            <RadioButton x:Name="NavMap"       Content="🗺️  地图编辑"   Style="{StaticResource NavButton}" GroupName="nav"/>
                            <RadioButton x:Name="NavDungeon"   Content="🏰  地牢编辑"   Style="{StaticResource NavButton}" GroupName="nav"/>
                            <TextBlock Text="编码" Style="{StaticResource NavSection}" Tag="sec"/>
                            <Rectangle Tag="sep" Width="1" Height="22" Margin="10,8" VerticalAlignment="Center"
                                       Fill="{DynamicResource BorderBrush}" Visibility="Collapsed"/>
                            <RadioButton x:Name="NavCode"      Content="💻  代码编写"   Style="{StaticResource NavButton}" GroupName="nav"/>
                            <RadioButton x:Name="NavDevEnv"    Content="🛠️  开发环境"   Style="{StaticResource NavButton}" GroupName="nav"/>
                            <TextBlock Text="资源" Style="{StaticResource NavSection}" Tag="sec"/>
                            <Rectangle Tag="sep" Width="1" Height="22" Margin="10,8" VerticalAlignment="Center"
                                       Fill="{DynamicResource BorderBrush}" Visibility="Collapsed"/>
                            <RadioButton x:Name="NavImport"    Content="📥  资源导入"   Style="{StaticResource NavButton}" GroupName="nav"/>
                            <TextBlock Text="调试与模拟" Style="{StaticResource NavSection}" Tag="sec"/>
                            <Rectangle Tag="sep" Width="1" Height="22" Margin="10,8" VerticalAlignment="Center"
                                       Fill="{DynamicResource BorderBrush}" Visibility="Collapsed"/>
                            <RadioButton x:Name="NavTest"      Content="🧪  测试工具"   Style="{StaticResource NavButton}" GroupName="nav"/>
                            <RadioButton x:Name="NavSim"       Content="⚡  模拟运行"   Style="{StaticResource NavButton}" GroupName="nav"/>
                            <TextBlock Text="视觉" Style="{StaticResource NavSection}" Tag="sec"/>
                            <Rectangle Tag="sep" Width="1" Height="22" Margin="10,8" VerticalAlignment="Center"
                                       Fill="{DynamicResource BorderBrush}" Visibility="Collapsed"/>
                            <RadioButton x:Name="NavShader"    Content="🌅  光影编辑"   Style="{StaticResource NavButton}" GroupName="nav"/>
                            <RadioButton x:Name="NavRender"    Content="✨  渲染编辑"   Style="{StaticResource NavButton}" GroupName="nav"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <ContentControl x:Name="ContentHost" Margin="0"/>
        </DockPanel>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="就绪" Foreground="{DynamicResource TextDimBrush}" FontSize="12"/>
                <TextBlock DockPanel.Dock="Right" x:Name="ClockText" Foreground="{DynamicResource TextDimBrush}" FontSize="12"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
