<UserControl x:Class="MCModCoder.Modules.RecipeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左：配方列表 ============ -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="配方库" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ComboBox x:Name="CategoryFilter" Width="110" SelectionChanged="Filter_Changed"/>
                        <Button x:Name="BtnNewRecipe" Content="新建" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Click="NewRecipe_Click"/>
                        <Button x:Name="BtnDelRecipe" Content="删除" Style="{StaticResource DangerButton}" Margin="6,0,0,0" Click="DelRecipe_Click"
                                ToolTip="删除选中配方（已保存到项目时会同时删除对应 JSON 文件）"/>
                    </StackPanel>
                    <TextBox x:Name="SearchBox" Margin="0,8,0,0" TextChanged="Filter_Changed"
                             Style="{StaticResource SearchBox}"
                             Tag="搜索 ID / 产物 / 分类…"/>
                    <TextBlock x:Name="ListCountText" Style="{StaticResource DimText}" Margin="0,6,0,0" Text="0 个配方"/>
                </StackPanel>
                <ListBox x:Name="RecipeList" Margin="0,8,0,0" SelectionChanged="RecipeSelected_Changed">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TypeDisplay}" Foreground="{DynamicResource AccentBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding CategoryDisplay}" Foreground="{DynamicResource TextDimBrush}" FontSize="11" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============ 中：编辑器 ============ -->
        <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="EditorPanel"/>
            </ScrollViewer>
        </Border>

        <!-- ============ 右：验证 + 导入导出 ============ -->
        <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="配方验证" FontWeight="SemiBold"/>
                    <Button x:Name="BtnValidate" Content="验证当前配方" Margin="0,8,0,0" Click="Validate_Click"/>
                    <Button x:Name="BtnValidateAll" Content="验证全部配方" Margin="0,6,0,0" Click="ValidateAll_Click"/>
                </StackPanel>
                <ListBox x:Name="ValidationList" Margin="0,8,0,0" Height="220" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Suggestion}" Foreground="{DynamicResource TextDimBrush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="JSON 导入 / 导出" FontWeight="SemiBold" Margin="0,12,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="导入 JSON…" Style="{StaticResource ToolButton}" Click="ImportJson_Click"/>
                        <Button Content="导出 JSON…" Style="{StaticResource ToolButton}" Margin="6,0,0,0" Click="ExportJson_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="批量导出数据包…" Style="{StaticResource ToolButton}" Click="ExportPack_Click"/>
                        <Button Content="保存全部到项目" Style="{StaticResource ToolButton}" Margin="6,0,0,0" Click="SaveAll_Click"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="JSON 与 Minecraft 数据包格式双向兼容；导出数据包自动生成 pack.mcmeta 与 data/&lt;ns&gt;/recipe/ 目录。"/>
                </StackPanel>
                <Grid/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
