<Window x:Class="MCModCoder.Modules.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Text="请输入：" Margin="0,0,0,8"/>
        <TextBox x:Name="InputBox" KeyDown="InputBox_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" Click="Ok_Click" Style="{StaticResource AccentButton}" Width="80" IsDefault="True"/>
            <Button Content="取消" Click="Cancel_Click" Width="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
