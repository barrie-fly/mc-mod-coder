<UserControl x:Class="MCModCoder.Modules.DungeonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- 左：生成规则 -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="生成模式" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton x:Name="ModeRandom" Content="随机生成" GroupName="dmode" IsChecked="True"/>
                        <RadioButton x:Name="ModeFixed" Content="固定结构（手动布局）" GroupName="dmode" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="随机种子" Style="{StaticResource DimText}" Margin="0,10,0,2"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="SeedBox" Width="100" Text="12345" TextAlignment="Right"/>
                        <Button Content="🎲" Style="{StaticResource ToolButton}" Margin="6,0,0,0" Click="RandomSeed_Click"/>
                    </StackPanel>
                    <TextBlock Text="房间数量" Style="{StaticResource DimText}" Margin="0,8,0,2"/>
                    <Slider x:Name="RoomCount" Minimum="3" Maximum="30" Value="10" IsSnapToTickEnabled="True" TickFrequency="1"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="房间尺寸" Style="{StaticResource DimText}" VerticalAlignment="Center"/>
                        <TextBox x:Name="MinSizeBox" Width="40" Margin="8,0,0,0" Text="7" TextAlignment="Right"/>
                        <TextBlock Text="~" Style="{StaticResource DimText}" Margin="4,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="MaxSizeBox" Width="40" Text="15" TextAlignment="Right"/>
                    </StackPanel>
                    <TextBlock Text="走廊宽度" Style="{StaticResource DimText}" Margin="0,8,0,2"/>
                    <Slider x:Name="CorrWidth" Minimum="1" Maximum="7" Value="3" IsSnapToTickEnabled="True" TickFrequency="1"/>
                    <CheckBox x:Name="IncTreasure" Content="包含宝物房" IsChecked="True" Margin="0,10,0,0"/>
                    <CheckBox x:Name="IncSpawner" Content="包含刷怪房" IsChecked="True"/>
                    <CheckBox x:Name="IncBoss" Content="包含 BOSS 房" IsChecked="True"/>
                    <TextBlock Text="环路连接概率" Style="{StaticResource DimText}" Margin="0,8,0,2"/>
                    <Slider x:Name="LoopRate" Minimum="0" Maximum="0.6" Value="0.15"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="墙体" Style="{StaticResource DimText}" VerticalAlignment="Center"/>
                        <TextBox x:Name="WallBox" Width="150" Margin="8,0,0,0" Text="minecraft:bricks"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="地板" Style="{StaticResource DimText}" VerticalAlignment="Center"/>
                        <TextBox x:Name="FloorBox" Width="150" Margin="8,0,0,0" Text="minecraft:stone_bricks"/>
                    </StackPanel>
                    <Button x:Name="BtnGenerate" Content="生成地牢" Margin="0,14,0,0"
                            Style="{StaticResource AccentButton}" Click="Generate_Click"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="保存…" Style="{StaticResource ToolButton}" Click="Save_Click"/>
                        <Button Content="加载…" Style="{StaticResource ToolButton}" Margin="6,0,0,0" Click="Load_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 中：俯视预览画布 -->
        <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource Panel2Brush}" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="添加房间" Style="{StaticResource ToolButton}" Click="AddRoom_Click"/>
                        <Button x:Name="BtnLink" Content="走廊连接模式" Style="{StaticResource ToolButton}" Margin="6,0,0,0" Click="LinkMode_Click"/>
                        <Button Content="删除选中" Style="{StaticResource ToolButton}" Margin="6,0,0,0" Click="DelSelected_Click"/>
                        <TextBlock x:Name="DunInfoText" Margin="14,0,0,0" VerticalAlignment="Center" Style="{StaticResource DimText}"/>
                    </StackPanel>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="DungeonCanvas" Width="1200" Height="900" Background="{DynamicResource DeepBgBrush}"
                            MouseLeftButtonDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove"
                            MouseLeftButtonUp="Canvas_MouseUp"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 右：测试与导出 -->
        <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10" Margin="10,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="测试生成" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox x:Name="TestCount" Width="60" Text="20" TextAlignment="Right"/>
                        <Button Content="× 次压力测试" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Click="TestGenerate_Click"/>
                    </StackPanel>
                    <TextBox x:Name="TestResultBox" Height="150" Margin="0,8,0,0" TextWrapping="Wrap"
                             AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>
                    <Button Content="推送到 3D 结构设计器" Margin="0,12,0,0"
                            Style="{StaticResource AccentButton}"
                            Click="PushToStructure_Click"/>
                    <TextBlock Style="{StaticResource DimText}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="将地牢布局转换为多层方块结构（墙体+地板+走廊镂空），推送到结构设计器可继续编辑与保存。"/>
                </StackPanel>
                <ListBox x:Name="RoomList" Margin="0,12,0,0" BorderThickness="1" Height="200" VerticalAlignment="Top"
                         SelectionChanged="RoomList_Selected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding KindCn}" Foreground="{DynamicResource TextDimBrush}" Margin="8,0,0,0" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
