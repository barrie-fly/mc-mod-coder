<UserControl x:Class="MCModCoder.Modules.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- 左：工具 -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="地形生成" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="种子" VerticalAlignment="Center" Style="{StaticResource DimText}"/>
                        <TextBox x:Name="SeedBox" Width="110" Margin="6,0,0,0" Text="minecraft"/>
                    </StackPanel>
                    <DockPanel Margin="0,8,0,2">
                        <TextBlock Text="基准高度" Style="{StaticResource DimText}"/>
                        <TextBlock Text="{Binding Value, ElementName=BaseHeight, StringFormat={}{0:F0}}" Style="{StaticResource DimText}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Slider x:Name="BaseHeight" Minimum="40" Maximum="100" Value="64" IsSnapToTickEnabled="True" TickFrequency="1"/>
                    <DockPanel Margin="0,6,0,2">
                        <TextBlock Text="地形起伏" Style="{StaticResource DimText}"/>
                        <TextBlock Text="{Binding Value, ElementName=Amplitude, StringFormat={}{0:F0}}" Style="{StaticResource DimText}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Slider x:Name="Amplitude" Minimum="4" Maximum="50" Value="20" IsSnapToTickEnabled="True" TickFrequency="1"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton x:Name="BioAuto" Content="按高度自动群系" GroupName="bio" IsChecked="True"/>
                        <RadioButton x:Name="BioBand" Content="温度带状群系" GroupName="bio" Margin="10,0,0,0"/>
                    </StackPanel>
                    <Button x:Name="BtnGenerate" Content="生成地形" Margin="0,10,0,0"
                            Style="{StaticResource AccentButton}" Click="Generate_Click"/>

                    <TextBlock Text="笔刷工具" FontWeight="SemiBold" Margin="0,16,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="BrushRaise"  Content="提升" GroupName="brush" IsChecked="True"/>
                        <RadioButton x:Name="BrushLower"  Content="降低" GroupName="brush" Margin="8,0,0,0"/>
                        <RadioButton x:Name="BrushSmooth" Content="平滑" GroupName="brush" Margin="8,0,0,0"/>
                    </StackPanel>
                    <RadioButton x:Name="BrushBiome" Content="群系绘制" GroupName="brush" Margin="0,6,0,0"/>
                    <ComboBox x:Name="BiomeCombo" Margin="0,6,0,0"/>
                    <DockPanel Margin="0,8,0,2">
                        <TextBlock Text="笔刷大小" Style="{StaticResource DimText}"/>
                        <TextBlock Text="{Binding Value, ElementName=BrushSize, StringFormat={}{0:F0}}" Style="{StaticResource DimText}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Slider x:Name="BrushSize" Minimum="1" Maximum="24" Value="4" IsSnapToTickEnabled="True" TickFrequency="1"/>
                    <DockPanel Margin="0,8,0,2">
                        <TextBlock Text="笔刷强度" Style="{StaticResource DimText}"/>
                        <TextBlock Text="{Binding Value, ElementName=BrushStrength, StringFormat={}{0:F0}}" Style="{StaticResource DimText}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Slider x:Name="BrushStrength" Minimum="1" Maximum="10" Value="3" IsSnapToTickEnabled="True" TickFrequency="1"/>
                    <CheckBox x:Name="ShowOres" Content="显示矿物分布" Margin="0,10,0,0" Checked="Render" Unchecked="Render"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 中：地图画布 -->
        <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource Panel2Brush}" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="导入…" Style="{StaticResource ToolButton}" Click="Import_Click"/>
                        <Button Content="导出…" Style="{StaticResource ToolButton}" Margin="6,0,0,0" Click="Export_Click"/>
                        <TextBlock x:Name="MapInfoText" Margin="14,0,0,0" VerticalAlignment="Center" Style="{StaticResource DimText}"/>
                    </StackPanel>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="MapImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"
                           MouseLeftButtonDown="Map_MouseDown" MouseMove="Map_MouseMove"
                           MouseLeftButtonUp="Map_MouseUp" MouseLeave="Map_MouseLeave"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 右：矿物配置 -->
        <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10" Margin="10,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="矿物分布设置" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,6" Text="每区块矿脉数 / 大小 / Y 范围"/>
                </StackPanel>
                <DataGrid x:Name="OreGrid" ItemsSource="{Binding}" Height="330">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="矿物" Binding="{Binding CnName}" Width="72" IsReadOnly="True"/>
                        <DataGridTextColumn Header="矿脉数" Binding="{Binding VeinsPerChunk}" Width="52"/>
                        <DataGridTextColumn Header="大小" Binding="{Binding VeinSize}" Width="48"/>
                        <DataGridTextColumn Header="最小Y" Binding="{Binding MinY}" Width="56"/>
                        <DataGridTextColumn Header="最大Y" Binding="{Binding MaxY}" Width="56"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="按配置重绘矿物" Margin="0,8,0,0" Click="RerollOres_Click"/>
                    <TextBlock Style="{StaticResource DimText}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="导出格式包含 heightmap.png（灰度高度图）与 world.json（群系/矿物/参数），可被数据生成器或自定义 WorldGen 读取。"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
