<UserControl x:Class="MCModCoder.Modules.RemoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 文件列表操作列 -->
        <DataTemplate x:Key="FileActionCell">
            <Button Content="{Binding ActionLabel}" Style="{StaticResource ToolButton}" Padding="8,3" Click="FileAction_Click"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="MainRoot" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 页签行 -->
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabSearch" Content="资源搜索" IsChecked="True" Checked="Tab_Changed" Style="{StaticResource TabRadio}"/>
                <RadioButton x:Name="TabPack" Content="整合包导入" Margin="6,0,0,0" Checked="Tab_Changed" Style="{StaticResource TabRadio}"/>
                <RadioButton x:Name="TabDownloads" Content="下载管理" Margin="6,0,0,0" Checked="Tab_Changed" Style="{StaticResource TabRadio}"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,10,0,0">

                <!-- ============ 页签1：资源搜索 ============ -->
                <Grid x:Name="SearchPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 筛选栏 -->
                    <WrapPanel>
                        <TextBox x:Name="SearchBox" Width="250" VerticalAlignment="Center" Margin="0,0,8,6"
                                 KeyDown="SearchBox_KeyDown"/>
                        <RadioButton x:Name="RbModrinth" Content="Modrinth" GroupName="platform" IsChecked="True"
                                     Checked="PlatformType_Changed" Style="{StaticResource TabRadio}" FontSize="12"
                                     VerticalAlignment="Center" Margin="0,0,4,6"/>
                        <RadioButton x:Name="RbCurse" Content="CurseForge" GroupName="platform"
                                     Checked="PlatformType_Changed" Style="{StaticResource TabRadio}" FontSize="12"
                                     VerticalAlignment="Center" Margin="0,0,12,6"/>
                        <RadioButton x:Name="RbTypeMod" Content="模组" GroupName="ptype" IsChecked="True"
                                     Checked="PlatformType_Changed" Style="{StaticResource TabRadio}" FontSize="12"
                                     VerticalAlignment="Center" Margin="0,0,4,6"/>
                        <RadioButton x:Name="RbTypePack" Content="整合包" GroupName="ptype"
                                     Checked="PlatformType_Changed" Style="{StaticResource TabRadio}" FontSize="12"
                                     VerticalAlignment="Center" Margin="0,0,12,6"/>
                        <TextBlock Text="版本" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,6,6"/>
                        <ComboBox x:Name="CmbVersion" Width="106" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <TextBlock Text="加载器" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,6,6"/>
                        <ComboBox x:Name="CmbLoader" Width="92" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <TextBlock Text="排序" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,6,6"/>
                        <ComboBox x:Name="CmbSort" Width="106" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <Button Content="🔍 搜索" Style="{StaticResource AccentButton}" VerticalAlignment="Center" Margin="0,0,8,6" Click="Search_Click"/>
                        <Button x:Name="BtnMore" Content="加载更多" Style="{StaticResource ToolButton}" VerticalAlignment="Center"
                                Margin="0,0,8,6" IsEnabled="False" Click="More_Click"/>
                        <CheckBox x:Name="ChkAutoMatch" Content="⤓ 自动匹配项目版本" IsChecked="True" VerticalAlignment="Center"
                                  Margin="4,0,0,6" ToolTip="下载时自动检测文件与项目的 MC 版本 / 加载器兼容性，不兼容时自动寻找并替换为兼容版本"/>
                    </WrapPanel>

                    <!-- AI 智能推荐词条 -->
                    <StackPanel x:Name="AiChipsPanel" Grid.Row="1" Orientation="Horizontal" Margin="2,0,0,8">
                        <TextBlock Text="🤖 AI 智能推荐" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ItemsControl x:Name="AiChips">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                                            ToolTip="{Binding Reason}" Tag="{Binding}" Click="AiChip_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 结果列表 -->
                    <Grid Grid.Row="2">
                        <ListBox x:Name="ResultList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="ResultList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="2" Padding="10" CornerRadius="6" Background="{DynamicResource PanelBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="40" Height="40">
                                                <Border Background="{DynamicResource Panel2Brush}" CornerRadius="6">
                                                    <TextBlock Text="📦" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Image x:Name="Icon" Source="{Binding IconSource}" Width="40" Height="40"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding AuthorDisplay}" Style="{StaticResource DimText}" FontSize="11"/>
                                                    <Border Background="{DynamicResource AccentDimBrush}" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding PlatformBadge}" FontSize="10"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding CategoriesDisplay}" Style="{StaticResource DimText}"
                                                               FontSize="11" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Hit.Summary}" Style="{StaticResource DimText}" FontSize="11.5"
                                                           Margin="0,3,0,0" TextWrapping="Wrap" MaxHeight="34"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding DownloadsDisplay}" Foreground="{DynamicResource AccentBrush}"
                                                           FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                <TextBlock Text="下载量" Style="{StaticResource DimText}" FontSize="10"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ResultEmptyText" Text="输入关键词后点击「🔍 搜索」，查找模组与整合包"
                                   Style="{StaticResource DimText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <!-- 详情面板 -->
                    <Border Grid.Row="3" x:Name="DetailPanel" Visibility="Collapsed" MaxHeight="340" Margin="0,8,0,0"
                            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="DetailTitle" FontSize="15" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                                        <Button x:Name="BtnResolveDeps" Content="⬇ 下载并解析依赖" Style="{StaticResource ToolButton}"
                                                Margin="12,0,0,0" Click="ResolveDeps_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DetailMeta" Style="{StaticResource DimText}" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="DetailSummary" Style="{StaticResource DimText}" Margin="0,3,0,0"
                                               TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="✕ 收起" Style="{StaticResource ToolButton}"
                                        VerticalAlignment="Top" Click="CloseDetail_Click"/>
                            </Grid>
                            <TextBlock x:Name="DetailLoading" Text="正在加载文件列表…" Style="{StaticResource DimText}"
                                       Margin="0,8,0,0" Visibility="Collapsed"/>
                            <ListView x:Name="FileList" Margin="0,8,0,0" MaxHeight="150" BorderThickness="1"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Setter Property="Padding" Value="6,5"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentDimBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="版本号" DisplayMemberBinding="{Binding VersionDisplay}" Width="160"/>
                                        <GridViewColumn Header="游戏版本" DisplayMemberBinding="{Binding GameVersionsDisplay}" Width="190"/>
                                        <GridViewColumn Header="加载器" DisplayMemberBinding="{Binding LoadersDisplay}" Width="90"/>
                                        <GridViewColumn Header="大小" DisplayMemberBinding="{Binding SizeDisplay}" Width="80"/>
                                        <GridViewColumn Header="发布日期" DisplayMemberBinding="{Binding DateDisplay}" Width="96"/>
                                        <GridViewColumn Header="操作" Width="110" CellTemplate="{StaticResource FileActionCell}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ 页签2：整合包导入 ============ -->
                <Grid x:Name="PackPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 本地导入 -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="本地导入" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                    <TextBlock Text="支持 Modrinth .mrpack 与 CurseForge zip 整合包。" Style="{StaticResource DimText}"
                                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <Button Content="📂 选择整合包文件…" Click="PickPack_Click"/>
                                    <Border x:Name="PackInfoPanel" Visibility="Collapsed" Margin="0,10,0,0"
                                            Background="{DynamicResource Panel2Brush}" CornerRadius="4" Padding="10">
                                        <StackPanel>
                                            <TextBlock x:Name="PackInfoName" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="PackInfoMeta" Style="{StaticResource DimText}" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="PackInfoCount" Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="BtnStartImport" Content="🚀 开始下载并导入" Style="{StaticResource AccentButton}"
                                            Margin="0,10,0,0" IsEnabled="False" Click="StartImport_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- 已下载的整合包文件 -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="已下载的整合包文件" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="LocalPacksEmpty" Text="暂无。可在「资源搜索」页下载整合包，文件保存于 remote/packs 目录。"
                                               Style="{StaticResource DimText}" TextWrapping="Wrap"/>
                                    <ListBox x:Name="LocalPacksList" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,3" Padding="8,6" CornerRadius="4" Background="{DynamicResource Panel2Brush}">
                                                    <DockPanel LastChildFill="True">
                                                        <Button DockPanel.Dock="Right" Content="导入" Style="{StaticResource ToolButton}"
                                                                VerticalAlignment="Center" Click="ImportPackFile_Click"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding SizeDisplay}" Style="{StaticResource DimText}" FontSize="11"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <!-- 已导入的整合包 -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="已导入的整合包" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="ImportedEmpty" Text="暂无导入记录。" Style="{StaticResource DimText}" TextWrapping="Wrap"/>
                                    <ListBox x:Name="ImportedPacksList" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,3" Padding="8,6" CornerRadius="4" Background="{DynamicResource Panel2Brush}">
                                                    <DockPanel LastChildFill="True">
                                                        <Button DockPanel.Dock="Right" Content="打开目录" Style="{StaticResource ToolButton}"
                                                                VerticalAlignment="Center" Click="OpenPackDir_Click"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding InfoLine}" Style="{StaticResource DimText}" FontSize="11"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 右列：导入进度 -->
                    <Border Grid.Column="1" x:Name="ImportProgressCard" Visibility="Collapsed" VerticalAlignment="Top"
                            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="导入进度" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                            <ProgressBar x:Name="PackProgress" Height="10" Maximum="100"/>
                            <TextBlock x:Name="PackCurrentFile" Style="{StaticResource DimText}" Margin="0,8,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PackStatText" Style="{StaticResource DimText}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ 页签3：下载管理 ============ -->
                <Grid x:Name="DownloadsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="重试全部失败" Style="{StaticResource ToolButton}" Click="RetryAllFailed_Click"/>
                        <Button Content="清除已完成" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Click="ClearDone_Click"/>
                        <Button Content="📂 打开 mods 目录" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Click="OpenMods_Click"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="TasksList" Background="Transparent" BorderThickness="0" Margin="0,10,0,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="2" Padding="12,10" CornerRadius="6" Background="{DynamicResource PanelBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <DockPanel LastChildFill="False">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" MaxWidth="560"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}"
                                                               FontSize="11" FontWeight="SemiBold" Margin="10,1,0,0"
                                                               VerticalAlignment="Center" ToolTip="{Binding ErrorText}"/>
                                                </StackPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Content="重试" Style="{StaticResource ToolButton}" Padding="8,2"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding RetryVisibility, Mode=OneWay}" Click="TaskAction_Click"/>
                                                    <Button Content="取消" Style="{StaticResource ToolButton}" Padding="8,2"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding CancelVisibility, Mode=OneWay}" Click="TaskAction_Click"/>
                                                    <Button Content="移除" Style="{StaticResource ToolButton}" Padding="8,2"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding RemoveVisibility, Mode=OneWay}" Click="TaskAction_Click"/>
                                                    <TextBlock Text="{Binding SizeDisplay}" Style="{StaticResource DimText}"
                                                               VerticalAlignment="Center" Margin="10,0,2,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <ProgressBar Grid.Row="1" Height="6" Maximum="100" Margin="0,7,0,0"
                                                         Value="{Binding ProgressPct, Mode=OneWay}"/>
                                            <TextBlock Grid.Row="2" Text="{Binding DestName}" Style="{StaticResource DimText}"
                                                       FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="TasksEmpty" Text="暂无下载任务。可到「资源搜索」页下载模组。"
                                   Style="{StaticResource DimText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- 未打开项目守卫遮罩 -->
        <Border x:Name="GuardMask" Visibility="Hidden" Background="{DynamicResource OverlayBrush}" IsHitTestVisible="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🔒" FontSize="42" HorizontalAlignment="Center"/>
                <TextBlock Text="尚未打开项目" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="资源导入需要先创建或打开一个项目：请点击右上角「新建项目」或「打开项目」。"
                           Style="{StaticResource DimText}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
