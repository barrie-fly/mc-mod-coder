<UserControl x:Class="MCModCoder.Modules.SimulatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl Margin="14">
        <!-- ============ 红石电路模拟 ============ -->
        <TabItem Header="⚡ 红石电路">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="方块选择" FontWeight="SemiBold"/>
                        <RadioButton x:Name="RsWire" Content="红石导线" GroupName="rs" IsChecked="True" Margin="0,6,0,0"/>
                        <RadioButton x:Name="RsTorch" Content="红石火把" GroupName="rs" Margin="0,4,0,0"/>
                        <RadioButton x:Name="RsLever" Content="拉杆（点击切换）" GroupName="rs" Margin="0,4,0,0"/>
                        <RadioButton x:Name="RsButton" Content="按钮（脉冲）" GroupName="rs" Margin="0,4,0,0"/>
                        <RadioButton x:Name="RsLamp" Content="红石灯" GroupName="rs" Margin="0,4,0,0"/>
                        <RadioButton x:Name="RsRepeater" Content="中继器" GroupName="rs" Margin="0,4,0,0"/>
                        <RadioButton x:Name="RsSolid" Content="实心方块" GroupName="rs" Margin="0,4,0,0"/>
                        <RadioButton x:Name="RsErase" Content="橡皮擦" GroupName="rs" Margin="0,4,0,0"/>

                        <TextBlock Text="信号强度可视化" Style="{StaticResource DimText}" Margin="0,12,0,0"/>
                        <CheckBox x:Name="ShowStrength" Content="显示信号强度数字" IsChecked="True"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="BtnRsRun" Content="▶ 自动运行"
                                    Style="{StaticResource SuccessButton}" Click="RsRun_Click"/>
                            <Button Content="单步" Style="{StaticResource ToolButton}" Margin="6,0,0,0" Click="RsStep_Click"/>
                            <Button Content="清空" Style="{StaticResource ToolButton}" Margin="6,0,0,0" Click="RsClear_Click"/>
                        </StackPanel>
                        <TextBlock Text="模拟速度" Style="{StaticResource DimText}" Margin="0,10,0,2"/>
                        <Slider x:Name="RsSpeed" Minimum="1" Maximum="20" Value="6" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <Button Content="载入示例：非门/时钟电路" Margin="0,10,0,0" Click="RsExample_Click"/>
                        <TextBlock Style="{StaticResource DimText}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="左键放置 / Shift+左键与拉杆·按钮交互 / 右键擦除。信号强度 15 级衰减，火把反相，中继器整流。"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource DeepBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Canvas x:Name="RsCanvas" MouseLeftButtonDown="Rs_MouseDown" MouseRightButtonDown="Rs_MouseDown"
                            MouseMove="Rs_MouseMove" ClipToBounds="True"/>
                </Border>
            </Grid>
        </TabItem>

        <!-- ============ 实体与交互 ============ -->
        <TabItem Header="🐕 实体与方块交互">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="实体生成" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="僵尸×5" Style="{StaticResource ToolButton}" Click="SpawnZombie_Click"/>
                            <Button Content="牛×5" Style="{StaticResource ToolButton}" Margin="6,0,0,0" Click="SpawnCow_Click"/>
                            <Button Content="羊×5" Style="{StaticResource ToolButton}" Margin="6,0,0,0" Click="SpawnSheep_Click"/>
                        </StackPanel>
                        <Button Content="清空实体" Style="{StaticResource ToolButton}" Margin="0,8,0,0" Click="ClearEntities_Click"/>

                        <TextBlock Text="游戏规则" FontWeight="SemiBold" Margin="0,14,0,4"/>
                        <CheckBox x:Name="RuleDaylight" Content="doDaylightCycle 昼夜循环" IsChecked="True"/>
                        <CheckBox x:Name="RuleKeepInv" Content="keepInventory 死亡不掉落"/>
                        <CheckBox x:Name="RuleMobGrief" Content="mobGriefing 生物破坏" IsChecked="True"/>
                        <TextBlock Text="时间刻度（0-24000）" Style="{StaticResource DimText}" Margin="0,10,0,2"/>
                        <Slider x:Name="TimeSlider" Minimum="0" Maximum="24000" Value="1000" IsSnapToTickEnabled="True" TickFrequency="100"/>
                        <TextBlock Text="重力（玩家跳跃模拟）" Style="{StaticResource DimText}" Margin="0,10,0,2"/>
                        <Slider x:Name="GravitySlider" Minimum="0" Maximum="2" Value="1"/>
                        <Button Content="跳跃！（物理测试）" Margin="0,10,0,0" Click="Jump_Click"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="BtnEntRun" Content="▶ 运行模拟"
                                    Style="{StaticResource SuccessButton}" Click="EntRun_Click"/>
                            <Button Content="重置" Style="{StaticResource ToolButton}" Margin="6,0,0,0" Click="EntReset_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource DeepBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Canvas x:Name="EntCanvas" MouseLeftButtonDown="EntCanvas_MouseDown" ClipToBounds="True"/>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
