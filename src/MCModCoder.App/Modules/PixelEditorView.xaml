<UserControl x:Class="MCModCoder.Modules.PixelEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="308"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左：工具栏 ============ -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="工具" FontWeight="SemiBold"/>
                    <RadioButton x:Name="ToolPencil"  Content="铅笔"  GroupName="tool" IsChecked="True" Margin="0,4,0,0"/>
                    <RadioButton x:Name="ToolEraser"  Content="橡皮"  GroupName="tool" Margin="0,4,0,0"/>
                    <RadioButton x:Name="ToolFill"    Content="油漆桶（区域填充）" GroupName="tool" Margin="0,4,0,0"/>
                    <RadioButton x:Name="ToolPipette" Content="吸管（取色）" GroupName="tool" Margin="0,4,0,0"/>

                    <TextBlock Text="笔刷大小" Margin="0,10,0,2" Style="{StaticResource DimText}"/>
                    <Slider x:Name="BrushSize" Minimum="1" Maximum="16" Value="1" IsSnapToTickEnabled="True" TickFrequency="1"/>
                    <TextBlock x:Name="BrushSizeText" Style="{StaticResource DimText}" Text="1 px"/>

                    <TextBlock Text="颜色" FontWeight="SemiBold" Margin="0,12,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="ColorSwatch" Width="34" Height="34" Background="#FF6B6B"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"/>
                        <TextBox x:Name="ColorHex" Width="86" Margin="8,0,0,0" Text="#FF6B6B"
                                 TextChanged="ColorHex_TextChanged" ToolTip="十六进制颜色，格式 #RRGGBB（如 #FF6B6B）"/>
                    </StackPanel>
                    <WrapPanel x:Name="PalettePanel" Margin="0,8,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="BtnUndo" Content="撤销" Style="{StaticResource ToolButton}" Click="BtnUndo_Click" ToolTip="Ctrl+Z"/>
                        <Button x:Name="BtnRedo" Content="重做" Style="{StaticResource ToolButton}" Margin="6,0,0,0" Click="BtnRedo_Click" ToolTip="Ctrl+Y"/>
                        <Button x:Name="BtnClear" Content="清空图层" Style="{StaticResource DangerButton}" Margin="6,0,0,0" Click="BtnClear_Click"
                                ToolTip="清空当前图层的全部像素（需确认）"/>
                    </StackPanel>
                    <CheckBox x:Name="SymmetryX" Content="左右对称绘制" Margin="0,10,0,0"/>

                    <TextBlock Text="分辨率" FontWeight="SemiBold" Margin="0,14,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="ResCombo" Width="92">
                            <ComboBoxItem>16</ComboBoxItem><ComboBoxItem>32</ComboBoxItem>
                            <ComboBoxItem>64</ComboBoxItem><ComboBoxItem>128</ComboBoxItem>
                            <ComboBoxItem>256</ComboBoxItem><ComboBoxItem>512</ComboBoxItem>
                            <ComboBoxItem>1024</ComboBoxItem>
                        </ComboBox>
                        <Button x:Name="BtnApplyRes" Content="适配转换" Style="{StaticResource ToolButton}"
                                Margin="6,0,0,0" Click="BtnApplyRes_Click"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,0"
                               Text="低清（≤16px）与高清（≥1024px）自动缩放转换，最近邻插值保持像素风。"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ 中：画布 + 预览 ============ -->
        <Grid Grid.Column="1" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 画布工具条 -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                <DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="缩放" VerticalAlignment="Center" Style="{StaticResource DimText}"/>
                        <Slider x:Name="ZoomSlider" Width="150" Minimum="0.25" Maximum="40" Value="16"
                                ValueChanged="Zoom_Changed" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ZoomText" Text="16×" VerticalAlignment="Center" Style="{StaticResource DimText}" Margin="6,0,0,0"/>
                        <CheckBox x:Name="ShowGrid" Content="网格" IsChecked="True" Margin="14,0,0,0"
                                  Checked="Grid_Changed" Unchecked="Grid_Changed"/>
                        <TextBlock x:Name="CoordText" Text="坐标：-, -" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource DimText}" x:Name="SizeText" Text="16 × 16"/>
                </DockPanel>
            </Border>

            <!-- 画布 -->
            <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Background="Transparent">
                    <Grid x:Name="CanvasHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <Image x:Name="CanvasImage" RenderOptions.BitmapScalingMode="NearestNeighbor"
                               MouseLeftButtonDown="Canvas_MouseDown" MouseRightButtonDown="Canvas_MouseDown"
                               MouseMove="Canvas_MouseMove" MouseLeave="Canvas_MouseLeave"
                               MouseLeftButtonUp="Canvas_MouseUp" MouseRightButtonUp="Canvas_MouseUp"/>
                        <Canvas x:Name="GridOverlay" IsHitTestVisible="False"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- 预览 -->
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,10,0,0" Height="150">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="实时预览：" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <RadioButton x:Name="PrevItem" Content="物品" GroupName="prev" IsChecked="True" Margin="10,0,0,0"
                                     Checked="Preview_Changed"/>
                        <RadioButton x:Name="PrevHand" Content="手持状态" GroupName="prev" Margin="10,0,0,0" Checked="Preview_Changed"/>
                        <RadioButton x:Name="PrevPlace" Content="放置状态" GroupName="prev" Margin="10,0,0,0" Checked="Preview_Changed"/>
                    </StackPanel>
                    <Canvas x:Name="PreviewCanvas" ClipToBounds="True"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ 右：图层 + 导出 ============ -->
        <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="图层" FontWeight="SemiBold"/>
                    <WrapPanel Margin="0,6,0,6">
                        <Button Content="新建" Style="{StaticResource ToolButton}" Click="LayerAdd_Click"/>
                        <Button Content="删除" Style="{StaticResource ToolButton}" Margin="4,0,0,0" Click="LayerDel_Click"/>
                        <Button Content="重命名" Style="{StaticResource ToolButton}" Margin="4,0,0,0" Click="LayerRename_Click"/>
                        <Button Content="上移" Style="{StaticResource ToolButton}" Margin="4,0,0,0" Click="LayerUp_Click"/>
                        <Button Content="下移" Style="{StaticResource ToolButton}" Margin="4,0,0,0" Click="LayerDown_Click"/>
                        <Button Content="合并" Style="{StaticResource ToolButton}" Margin="4,0,0,0" Click="LayerMergeDown_Click"/>
                    </WrapPanel>
                </StackPanel>

                <ListBox x:Name="LayerList" Height="180" BorderThickness="1" SelectionChanged="LayerSelected_Changed">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding Visible}" Margin="0,0,6,0" Checked="LayerVis_Changed" Unchecked="LayerVis_Changed"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource TextDimBrush}"
                                           FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                    <TextBlock Text="图层透明度" Style="{StaticResource DimText}"/>
                    <Slider x:Name="LayerOpacity" Minimum="0" Maximum="100" Value="100"
                            ValueChanged="LayerOpacity_Changed"/>
                    <TextBlock x:Name="LayerOpacityText" Style="{StaticResource DimText}" Text="100%"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="导出" FontWeight="SemiBold" Margin="0,12,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="ExportFormat" Width="96">
                            <ComboBoxItem Content="PNG（推荐）" IsSelected="True"/>
                            <ComboBoxItem Content="JPEG"/>
                            <ComboBoxItem Content="TIFF"/>
                        </ComboBox>
                        <Button x:Name="BtnExport" Content="导出图像…" Style="{StaticResource ToolButton}"
                                Margin="8,0,0,0" Click="BtnExport_Click"/>
                    </StackPanel>
                    <Button x:Name="BtnExportPack" Content="生成资源包结构…" Margin="0,8,0,0"
                            Style="{StaticResource AccentButton}" Click="BtnExportPack_Click"/>
                    <Button x:Name="BtnSaveTexture" Content="保存到项目纹理库" Margin="0,8,0,0" Click="BtnSaveTexture_Click"/>
                </StackPanel>

                <Grid/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
